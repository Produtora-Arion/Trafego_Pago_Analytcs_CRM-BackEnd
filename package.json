{
  "name": "mcp-google-ads",
  "version": "1.0.0",
  "description": "MCP Server para Google Ads - Produtora Arion",
  "scripts": {
    "build": "nest build",
    "start": "node dist/src/main",
    "start:api": "SERVER_MODE=http node dist/src/main",
    "start:mcp": "node dist/src/main",
    "start:dev": "SERVER_MODE=http nest start --watch",
    "get-token": "ts-node -r tsconfig-paths/register scripts/get-refresh-token.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^11.1.26",
    "@nestjs/typeorm": "^11.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.11.1",
    "google-ads-api": "^23.0.1",
    "googleapis": "^144.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "typeorm": "^1.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.0"
  }
}
